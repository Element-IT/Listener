PORT=3000
TZ=Asia/Yekaterinburg
ACTION_SCHEDULER_ENABLED=true
ACTION_SCHEDULER_INTERVAL_SECONDS=30
ACTION_SCHEDULER_RETRY_MAX_AGE_HOURS=168
MANUAL_ACTION_CLAIM_TTL_HOURS=36

# Camera/NVR connection.
CAMERA_SCHEME=http
CAMERA_HOST=192.168.1.100
CAMERA_HTTP_PORT=80
CAMERA_RTSP_PORT=554
CAMERA_USER=admin
CAMERA_PASSWORD=change-me

# auto, xm, hikvision, dahua, or generic
CAMERA_VENDOR=auto

# local is usually what the camera web UI shows. Use utc if your NVR expects UTC timestamps.
HIKVISION_TIME_MODE=local

# off, voice, or strong. Voice reduces hum/hiss for camera microphones.
AUDIO_FILTER=voice

# mulaw matches this NVR live RTSP audio; use alaw for G.711A devices.
XM_AUDIO_CODEC=mulaw

# GigaAM-v3 transcription.
PYTHON_PATH=python
GIGAAM_MODEL=v3_e2e_rnnt
GIGAAM_DEVICE=auto
TRANSCRIPTION_CHUNK_SECONDS=20
TRANSCRIPTION_LIVE_SECONDS=18
# Maximum audio capture per archive request, clamped to 5-60 seconds.
TRANSCRIPTION_CAPTURE_CHUNK_SECONDS=30
# 0 means no archive duration cap.
TRANSCRIPTION_ARCHIVE_MAX_SECONDS=0

# Local PostgreSQL storage.
POSTGRES_ENABLED=true
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=camera_audio_listener

# Optional: use when your camera has a custom RTSP route.
# Supported placeholders: {user}, {password}, {host}, {rtspPort}, {channel}, {stream}, {subtype}
# RTSP_URL_TEMPLATE=rtsp://{user}:{password}@{host}:{rtspPort}/Streaming/Channels/{channel}01

# OpenAI API for the OpenAI API tab.
# OPENAI_API_KEY=replace-with-api-key
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_TIMEOUT_MS=120000
# Optional proxy for OpenAI requests only. vpnxxx://auto discovers its current Privoxy HTTP port.
# OPENAI_PROXY_URL=vpnxxx://auto
# For another HTTP(S) CONNECT proxy, use its URL, for example: http://127.0.0.1:8118

# Email reports. Recipients are edited in app settings.
REPORT_SMTP_HOST=smtp.yandex.ru
REPORT_SMTP_PORT=465
REPORT_SMTP_SECURE=true
REPORT_SMTP_STARTTLS=false
REPORT_SMTP_TIMEOUT_MS=30000
REPORT_SMTP_RETRIES=2
REPORT_SMTP_RETRY_DELAY_MS=1500
REPORT_SMTP_FALLBACK_587=true
REPORT_SMTP_USER=mailbox@yandex.ru
REPORT_SMTP_PASSWORD=app-password
REPORT_SMTP_FROM=mailbox@yandex.ru
# Optional fallback recipients if app settings are empty.
# REPORT_EMAIL_TO=manager@example.com,security@example.com

# Optional: set this if ffmpeg is not on PATH.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
